extends SceneTree
var errors := 0
func check(ok: bool, message: String):
 print(("PASS: " if ok else "FAIL: ")+message)
 if not ok: errors+=1
func _initialize(): call_deferred("run")
func frames(count:=4):
 for i in range(count): await process_frame
func run():
 var game=load("res://Scenes/Game.tscn").instantiate()
 root.add_child(game)
 current_scene=game
 await frames()
 var hp=game.get_node("plr/Health")
 hp.dmg(10)
 check(game.state=="map" and game.battle==null,"Run begins on map")
 game.map_view._select("a")
 game.map_view._activate()
 await frames()
 check(game.state=="battle" and game.battle!=null,"Node launches real battle")
 var enemies=game.battle.get_node("enemy_container")
 check(enemies.enemy_count==2,"Standard encounter has two enemies")
 game._toggle_map()
 check(game.map_view.read_only and game.map_layer.visible,"Battle map is inspection only")
 var pending=game.route.pending
 game.map_view._select("b")
 game.map_view._activate()
 check(game.route.pending==pending,"Cannot skip battle through map")
 game._toggle_map()
 var manager=game.battle.get_node("CardManager")
 var enemy_hp=enemies.get_child(0).get_node("Health")
 var old_hp=enemy_hp.current_health
 card_data.get_data("Fireball")["functionality"].call(enemies.get_child(0))
 check(enemy_hp.current_health==old_hp-24 and not enemy_hp.isdead(),"Existing fireball damage works without one-shotting")
 manager.current_energy=0
 check(not manager.can_afford("Slash"),"No-energy cards remain unaffordable")
 await manager.get_node("BattleTurns").end_turn()
 check(manager.current_energy==3 and hp.current_health==82,"Enemy turn deals 8 damage and refills energy")
 hp.heal(8)
 for enemy in enemies.get_children(): enemy.get_node("Health").dmg(9999)
 await create_timer(1.2).timeout
 await frames()
 check(game.state=="reward","Victory launches reward")
 var choice=game.reward.get_child(0)
 var card_id=choice.card_id
 var before=deck.player_deck.get(card_id,0)
 choice.pressed.emit()
 await frames()
 check(deck.player_deck.get(card_id,0)==before+1,"Reward adds exactly one card")
 check(game.state=="map" and game.route.current=="a","Reward returns to correct map position")
 check(hp.current_health==90,"Health carries between encounters")
 game.map_view._select("c")
 game.map_view._activate()
 await frames()
 check(game.state=="reward","Treasure opens card reward")
 game.reward.get_child(0).pressed.emit()
 await frames()
 check(game.route.current=="c" and hp.current_health==90,"Treasure completes without resetting health")
 game.queue_free()
 await frames()
 var fresh=load("res://Scenes/Game.tscn").instantiate()
 root.add_child(fresh)
 current_scene=fresh
 await frames()
 check(fresh.get_node("plr/Health").current_health==100 and deck.player_deck=={"Fireball":1,"Slash":3},"New run resets health and deck")
 fresh.map_view._select("b")
 fresh.map_view._activate()
 await frames()
 for enemy in fresh.battle.get_node("enemy_container").get_children(): enemy.get_node("Health").dmg(9999)
 await create_timer(1.2).timeout
 await frames()
 fresh.reward.get_child(0).pressed.emit()
 await frames()
 check(fresh.state=="reward" and fresh.rewards_remaining==1,"Elite grants second card choice")
 fresh.reward.get_child(0).pressed.emit()
 await frames()
 fresh.get_node("plr/Health").dmg(40)
 fresh.map_view._select("e")
 fresh.map_view._activate()
 check(fresh.get_node("plr/Health").current_health==85 and fresh.route.current=="e","Rest heals 25 and advances once")
 fresh.queue_free()
 await frames()
 await create_timer(1.0).timeout
 print("Failures: ",errors)
 quit(1 if errors else 0)
